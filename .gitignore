# Secrets and local env
.env
.env.local
*.pem

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Large generated artifacts (rebuild with scripts/build_index.py)
indexes/*.index
indexes/embeddings.npy
indexes/*.bin

# Keep processed extracts out of git; rebuild via ingest
data/processed/*
!data/processed/.gitkeep

# Official PDF binaries can be large — keep paths local
data/raw/**/*.pdf
!data/raw/**/.gitkeep

# Evaluation outputs (regenerate locally)
results/*
!results/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/
