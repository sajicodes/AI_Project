# Hosted LLM API (OpenAI-compatible). Required for answer generation.
# Retrieval and indexing work without this key; the UI will show a clear error
# if generation is attempted without credentials.
#
# Defaults below target Groq free tier (OpenAI-compatible). Set LLM_API_KEY in
# secrets or in a local .env (never commit real keys).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# FastAPI (api/main.py) — set on Railway / Render / Fly
# Comma-separated browser origins allowed to call the API (Vercel URL).
# Use * for local demos; tighten in production.
CORS_ORIGINS=*

# Next.js (web/) — set on Vercel as NEXT_PUBLIC_API_URL
# NEXT_PUBLIC_API_URL=https://your-campusask-api.up.railway.app

# Optional overrides (defaults match src/config.py)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# TOP_K=8
# EVIDENCE_MIN_SCORE=0.38

# Firebase / Firestore — check-in (login) logs only (not vector search).
# Create a Firebase project, enable Cloud Firestore, then create a service
# account and keep the JSON key out of git.
# FIREBASE_ENABLED=true
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Local file path (preferred on a laptop):
# FIREBASE_CREDENTIALS_PATH=/absolute/path/to/serviceAccount.json
# Or paste the full service-account JSON as a single-line secret (Railway/Render):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Optional alias also accepted: GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
#
# Demo-only admin list of recent login logs (GET /v1/admin/login-logs).
# Send header X-Admin-Token with the same value. Leave unset to keep the
# endpoint disabled (503).
# CAMPUSASK_ADMIN_TOKEN=change-me-for-local-demo
