# Hosted LLM API (OpenAI-compatible). Required for answer generation.
# Retrieval and indexing work without this key; the UI will show a clear error
# if generation is attempted without credentials.
#
# Defaults below target Groq free tier (OpenAI-compatible). Set LLM_API_KEY in
# secrets or in a local .env (never commit real keys).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# FastAPI (api/main.py) — set on Railway / Render / Fly
# Comma-separated browser origins allowed to call the API (Vercel URL).
# Use * for local demos; tighten in production.
CORS_ORIGINS=*

# Next.js (web/) — set on Vercel as NEXT_PUBLIC_API_URL
# NEXT_PUBLIC_API_URL=https://your-campusask-api.up.railway.app

# Optional overrides (defaults match src/config.py)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# TOP_K=8
# EVIDENCE_MIN_SCORE=0.38
