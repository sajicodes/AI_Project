# Hosted LLM API (OpenAI-compatible). Required for answer generation.
# Retrieval and indexing work without this key; the UI will show a clear error
# if generation is attempted without credentials.
#
# Defaults below target Groq (OpenAI-compatible). Set LLM_API_KEY in secrets
# or in a local .env (never commit real keys).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Optional overrides (defaults match src/config.py)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# TOP_K=5
# EVIDENCE_MIN_SCORE=0.45
